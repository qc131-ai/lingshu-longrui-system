# Local example. Staging / production should use managed PostgreSQL and a non-demo database name.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/astralink_jiaowu?schema=public"
PORT=4000
NODE_ENV="development"
APP_ENV="local"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
JWT_SECRET="replace-with-long-random-secret"
AUTH_TOKEN_SECRET="replace-with-long-random-secret"
VITE_API_BASE_URL="http://localhost:3000/api"
VITE_API_PROXY_TARGET="http://localhost:4000"

# AI provider configuration. Keep API keys on the backend only.
AI_PROVIDER="mock"
AI_MODE="local"
AI_TIMEOUT_MS=30000
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-flash"
