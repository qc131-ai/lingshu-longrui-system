  @@index([studentId])
  @@map("competition_projects")
}

model ImportLog {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  importType     String    @map("import_type") @db.VarChar(50)
  fileName       String?   @map("file_name") @db.VarChar(255)
  totalRows      Int       @default(0) @map("total_rows")
  successRows    Int       @default(0) @map("success_rows")
  failedRows     Int       @default(0) @map("failed_rows")
  status         String    @default("previewed") @db.VarChar(30)
  result         Json?
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  importedAt     DateTime? @map("imported_at") @db.Timestamptz
  rolledBackAt   DateTime? @map("rolled_back_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([importType, status])
  @@map("import_logs")
}
